<Window x:Class="Kka.Desk.PortalSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KKA Portal Sync" Height="720" Width="1000" MinHeight="560" MinWidth="780"
        WindowStartupLocation="CenterOwner" Background="#0B1422">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="KKA PORTAL CONNECTION" Foreground="#D6B56D" FontSize="11" FontWeight="Bold"/>
      <TextBlock Text="Synchronise client and family profiles" Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,4"/>
      <TextBlock Text="Read-only sync from the existing portal. Your password and session are not saved to disk." Foreground="#9AA9BC" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Grid.Row="1" Background="#15243A" BorderBrush="#30435C" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,10,0">
          <TextBlock Text="Registered email" Foreground="#C7D2E0" Margin="0,0,0,6"/>
          <TextBox x:Name="EmailBox" Height="36" Padding="9" Background="#0B1422" Foreground="White" BorderBrush="#40536D"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="10,0,10,0">
          <TextBlock Text="Password" Foreground="#C7D2E0" Margin="0,0,0,6"/>
          <PasswordBox x:Name="PasswordBox" Height="36" Padding="9" Background="#0B1422" Foreground="White" BorderBrush="#40536D"/>
        </StackPanel>
        <Button x:Name="SignInButton" Grid.Column="2" Content="Sign in" Click="SignIn_Click" VerticalAlignment="Bottom" Height="36" Padding="18,0" Background="#D6B56D" Foreground="#142033" BorderThickness="0" FontWeight="Bold"/>
      </Grid>
    </Border>
    <Border x:Name="OtpPanel" Grid.Row="2" Visibility="Collapsed" Background="#15243A" BorderBrush="#30435C" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Email verification required" Foreground="#D6B56D" FontWeight="Bold"/>
          <TextBlock x:Name="OtpHintText" Text="Enter the 6-digit code from the KKA portal email." Foreground="#C7D2E0" Margin="0,5,0,0"/>
        </StackPanel>
        <TextBox x:Name="OtpBox" Grid.Column="1" Height="36" MaxLength="6" Padding="9" Background="#0B1422" Foreground="White" BorderBrush="#40536D" VerticalContentAlignment="Center"/>
        <Button Grid.Column="2" Content="Verify &amp; sync" Click="VerifyOtp_Click" Height="36" Padding="16,0" Margin="12,0,0,0" Background="#D6B56D" Foreground="#142033" BorderThickness="0" FontWeight="Bold"/>
      </Grid>
    </Border>
    <Grid Grid.Row="3">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock x:Name="StatusText" Grid.Row="0" Text="Not connected. Sign in to run a live read-only sync." Foreground="#9AA9BC" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <DataGrid x:Name="ProfilesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                Background="#121E30" Foreground="#E6EDF6" RowBackground="#15243A" AlternatingRowBackground="#1A2A40"
                BorderBrush="#30435C" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Family / Account ID" Binding="{Binding FamilyAccountId}" Width="1.25*"/>
          <DataGridTextColumn Header="Member Profile ID" Binding="{Binding ProfileId}" Width="1.25*"/>
          <DataGridTextColumn Header="Profile" Binding="{Binding DisplayName}" Width="*"/>
          <DataGridTextColumn Header="Legal name" Binding="{Binding LegalName}" Width="*"/>
          <DataGridTextColumn Header="Relationship" Binding="{Binding Relationship}" Width="*"/>
          <DataGridCheckBoxColumn Header="Primary" Binding="{Binding IsPrimary}" Width="70"/>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </Grid>
</Window>
