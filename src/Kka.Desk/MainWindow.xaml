<Window x:Class="Kka.Desk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kka.Desk"
        Title="KKA Desk" Height="860" Width="1400" MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}"
        FontFamily="{StaticResource AppFont}" Foreground="{StaticResource InkBrush}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        Loaded="MainWindow_Loaded">
  <Grid Background="{StaticResource CanvasBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="18,20,18,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,1,0,30">
          <Border Width="38" Height="38" CornerRadius="12" Background="#20395C" Margin="0,0,11,0">
            <TextBlock Text="K" Foreground="White" FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="KKA" Foreground="{StaticResource InkBrush}" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="DESK" Foreground="{StaticResource SecondaryInkBrush}" FontSize="9"
                       FontWeight="Bold" Margin="1,1,0,0"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1">
          <TextBlock Text="WORKSPACE" Foreground="{StaticResource MutedInkBrush}" FontSize="10"
                     FontWeight="Bold" Margin="11,0,0,9"/>
          <Button x:Name="OverviewNavButton" Content="Overview" Click="Overview_Click"
                  Style="{StaticResource NavigationButtonStyle}" Tag="Active" Margin="0,2"
                  AutomationProperties.Name="Overview" ToolTip="Overview"/>
          <Button x:Name="QueueNavButton" Content="Work queue" Click="Queue_Click"
                  Style="{StaticResource NavigationButtonStyle}" Margin="0,2"
                  AutomationProperties.Name="Work queue" ToolTip="Personal work queue"/>
          <Button x:Name="DirectoryNavButton" Content="Client directory" Click="Directory_Click"
                  Style="{StaticResource NavigationButtonStyle}" Margin="0,2"
                  AutomationProperties.Name="Client directory" ToolTip="Read-only KKA profile sync"/>
          <Button x:Name="DocumentsNavButton" Content="Documents" Click="Documents_Click"
                  Style="{StaticResource NavigationButtonStyle}" Margin="0,2"
                  AutomationProperties.Name="Documents" ToolTip="Documents"/>
          <Button x:Name="QueriesNavButton" Content="Queries" Click="Queries_Click"
                  Style="{StaticResource NavigationButtonStyle}" Margin="0,2"
                  AutomationProperties.Name="Queries" ToolTip="Queries"/>

          <TextBlock Text="ADMINISTRATION" Foreground="{StaticResource MutedInkBrush}" FontSize="10"
                     FontWeight="Bold" Margin="11,26,0,9"/>
          <Button x:Name="AdminNavButton" Content="Admin" Click="Admin_Click"
                  Style="{StaticResource NavigationButtonStyle}" Margin="0,2"
                  AutomationProperties.Name="Admin" ToolTip="Administration"/>
          <Button Content="Sync with KKA Portal" Click="PortalSync_Click"
                  Style="{StaticResource NavigationButtonStyle}" Margin="0,2"
                  AutomationProperties.Name="Sync with KKA Portal" ToolTip="Sign in and sync profiles"/>
          <Button Content="Income Tax &amp; GST" Click="TaxAutomation_Click"
                  Style="{StaticResource NavigationButtonStyle}" Margin="0,2"
                  AutomationProperties.Name="Income Tax &amp; GST" ToolTip="Tax preview and local credential settings"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="4,22,4,0">
          <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,14"/>
          <TextBlock Text="Kamal Kuldeep &amp; Associates" Foreground="{StaticResource SecondaryInkBrush}"
                     FontSize="10"/>
          <TextBlock Text="Private staff workspace" Foreground="{StaticResource MutedInkBrush}"
                     FontSize="10" Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="112"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="34,20">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock x:Name="PageEyebrow" Text="KKA DESK" Foreground="{StaticResource AccentBrush}"
                       FontSize="10" FontWeight="Bold"/>
            <TextBlock x:Name="PageTitle" Text="Good day." Foreground="{StaticResource InkBrush}"
                       FontSize="27" FontWeight="SemiBold" Margin="0,4,0,0"/>
            <TextBlock x:Name="PageSubtitle" Text="Your firm's work, organised in one place."
                       Foreground="{StaticResource SecondaryInkBrush}" FontSize="12" Margin="0,3,0,0"/>
          </StackPanel>
          <Border Grid.Column="1" Background="#F7F8FA" BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1" CornerRadius="10" Padding="12,9" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="7" Height="7" Fill="{StaticResource WarningBrush}" Margin="0,0,8,0"/>
              <TextBlock Text="Portal not connected" Foreground="{StaticResource SecondaryInkBrush}" FontSize="11"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="34,28,34,28">
        <Grid x:Name="OverviewContent" Visibility="Visible">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#213A5C" CornerRadius="17" Padding="26,24"
                  Margin="0,0,0,18">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center" MaxWidth="640">
                <TextBlock Text="WELCOME TO KKA DESK" Foreground="#C5D4E7" FontSize="10" FontWeight="Bold"/>
                <TextBlock Text="One workspace. Clear priorities." Foreground="White" FontSize="23"
                           FontWeight="SemiBold" Margin="0,9,0,6"/>
                <TextBlock Text="Keep your personal reminders close, and open the existing portal flow when you need to refresh administrator profiles."
                           Foreground="#D7E0EC" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
              <Button Grid.Column="1" Content="Open work queue" Click="OpenQueue_Click"
                      Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"
                      Margin="20,0,0,0" AutomationProperties.Name="Open work queue"/>
            </Grid>
          </Border>

          <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,0">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,9,0">
              <StackPanel>
                <TextBlock Text="PERSONAL WORK" Foreground="{StaticResource MutedInkBrush}"
                           FontSize="10" FontWeight="Bold"/>
                <TextBlock x:Name="OpenReminderCountText" Text="Loading…" Foreground="{StaticResource InkBrush}"
                           FontSize="26" FontWeight="SemiBold" Margin="0,15,0,4"/>
                <TextBlock x:Name="OpenReminderSummaryText" Text="Reading your local reminder list."
                           Foreground="{StaticResource SecondaryInkBrush}" FontSize="12" TextWrapping="Wrap"/>
                <Button Content="View queue" Click="OpenQueue_Click" Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Left" Margin="0,18,0,0" Padding="11,7"
                        AutomationProperties.Name="View work queue"/>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="20" Margin="9,0">
              <StackPanel>
                <TextBlock Text="NEXT REMINDER" Foreground="{StaticResource MutedInkBrush}"
                           FontSize="10" FontWeight="Bold"/>
                <TextBlock x:Name="NextReminderTitleText" Text="Loading…" Foreground="{StaticResource InkBrush}"
                           FontSize="17" FontWeight="SemiBold" Margin="0,15,0,6"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48"/>
                <TextBlock x:Name="NextReminderDueText" Text=""
                           Foreground="{StaticResource SecondaryInkBrush}" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="20" Margin="9,0,0,0">
              <StackPanel>
                <TextBlock Text="KKA PORTAL" Foreground="{StaticResource MutedInkBrush}"
                           FontSize="10" FontWeight="Bold"/>
                <TextBlock Text="Not connected" Foreground="{StaticResource InkBrush}" FontSize="17"
                           FontWeight="SemiBold" Margin="0,15,0,6"/>
                <TextBlock Text="Profile sync remains read-only and available through the existing verification flow."
                           Foreground="{StaticResource SecondaryInkBrush}" FontSize="12" TextWrapping="Wrap"/>
                <Button Content="Sign in &amp; sync profiles" Click="PortalSync_Click"
                        Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"
                        Margin="0,18,0,0" Padding="11,7"
                        AutomationProperties.Name="Sign in and sync profiles"/>
              </StackPanel>
            </Border>
          </UniformGrid>
        </Grid>

        <Grid x:Name="WorkQueueContent" Visibility="Collapsed">
          <local:WorkQueueView x:Name="WorkQueuePage"/>
        </Grid>

        <Grid x:Name="DirectoryContent" Visibility="Collapsed">
          <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1" CornerRadius="16" Padding="30" VerticalAlignment="Top">
            <StackPanel MaxWidth="680">
              <TextBlock Text="READ-ONLY ADMIN PROFILE SYNC" Foreground="{StaticResource AccentBrush}"
                         FontSize="10" FontWeight="Bold"/>
              <TextBlock Text="Client directory" Foreground="{StaticResource InkBrush}" FontSize="21"
                         FontWeight="SemiBold" Margin="0,8,0,6"/>
              <TextBlock Text="The current integration signs in through the existing KKA portal verification flow and reads active family/profile associations for an administrator. It does not create or change portal records."
                         Foreground="{StaticResource SecondaryInkBrush}" FontSize="13" TextWrapping="Wrap"/>
              <Button Content="Sign in &amp; sync profiles" Click="PortalSync_Click"
                      Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"
                      Margin="0,19,0,0" AutomationProperties.Name="Sign in and sync profiles"/>
              <Border Background="#F7F8FA" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                      CornerRadius="10" Padding="13" Margin="0,20,0,0">
                <TextBlock Text="Client data is not cached here. Staff assignment-scoped directory access remains gated until its server-side authorization has been reviewed."
                           Foreground="{StaticResource SecondaryInkBrush}" FontSize="12" TextWrapping="Wrap"/>
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <Grid x:Name="PlaceholderContent" Visibility="Collapsed">
          <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1" CornerRadius="16" Padding="30" VerticalAlignment="Top">
            <StackPanel MaxWidth="700">
              <TextBlock x:Name="PlaceholderEyebrow" Text="MODULE STATUS"
                         Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
              <TextBlock x:Name="PlaceholderTitle" Text="Module" Foreground="{StaticResource InkBrush}"
                         FontSize="21" FontWeight="SemiBold" Margin="0,8,0,6"/>
              <TextBlock x:Name="PlaceholderDescription" Text="This module is not connected yet."
                         Foreground="{StaticResource SecondaryInkBrush}" FontSize="13" TextWrapping="Wrap"/>
              <Border Background="#F7F8FA" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                      CornerRadius="10" Padding="13" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="7" Height="7" Fill="{StaticResource WarningBrush}"
                           VerticalAlignment="Center" Margin="0,0,9,0"/>
                  <TextBlock x:Name="PlaceholderStatusText" Text="Not connected"
                             Foreground="{StaticResource SecondaryInkBrush}" FontSize="12"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
