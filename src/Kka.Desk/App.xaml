<Application x:Class="Kka.Desk.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <Color x:Key="Navy">#101B2D</Color>
    <Color x:Key="Panel">#18263B</Color>
    <Color x:Key="Gold">#D6B56D</Color>
    <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource Navy}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource Panel}"/>
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource Gold}"/>
  </Application.Resources>
</Application>
