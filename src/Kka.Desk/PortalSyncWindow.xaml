<Window x:Class="Kka.Desk.PortalSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KKA Portal Sync" Height="740" Width="1120" MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource InkBrush}" FontFamily="{StaticResource AppFont}">
  <Grid Margin="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="KKA PORTAL CONNECTION" Foreground="{StaticResource AccentBrush}"
                 FontSize="10" FontWeight="Bold"/>
      <TextBlock Text="Synchronise client and family profiles" Foreground="{StaticResource InkBrush}"
                 FontSize="25" FontWeight="SemiBold" Margin="0,6,0,4"/>
      <TextBlock Text="Read-only sync from the existing portal. Your password and session are not saved to disk."
                 Foreground="{StaticResource SecondaryInkBrush}" FontSize="12" TextWrapping="Wrap"/>
    </StackPanel>

    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Registered email" Foreground="{StaticResource InkBrush}" FontSize="12"
                     FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBox x:Name="EmailBox" Height="42" Style="{StaticResource InputTextBoxStyle}"
                   AutomationProperties.Name="Registered email" KeyDown="CredentialInput_KeyDown"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Password" Foreground="{StaticResource InkBrush}" FontSize="12"
                     FontWeight="SemiBold" Margin="0,0,0,6"/>
          <PasswordBox x:Name="PasswordBox" Height="42" Padding="11,9" Background="{StaticResource SurfaceBrush}"
                       Foreground="{StaticResource InkBrush}" BorderBrush="{StaticResource LineBrush}"
                       BorderThickness="1" AutomationProperties.Name="KKA portal password"
                       KeyDown="CredentialInput_KeyDown"/>
        </StackPanel>
        <Button x:Name="SignInButton" Grid.Column="3" Content="Sign in" Click="SignIn_Click"
                VerticalAlignment="Bottom" Margin="18,0,0,0" Style="{StaticResource PrimaryButtonStyle}"
                AutomationProperties.Name="Sign in"/>
      </Grid>
    </Border>

    <Border x:Name="OtpPanel" Grid.Row="2" Visibility="Collapsed" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14"
            Padding="16" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
          <TextBlock Text="Email verification required" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold"/>
          <TextBlock x:Name="OtpHintText" Text="Enter the 6-digit code from the KKA portal email."
                     Foreground="{StaticResource SecondaryInkBrush}" FontSize="12" Margin="0,5,0,0"
                     TextWrapping="Wrap"/>
        </StackPanel>
        <TextBox x:Name="OtpBox" Grid.Column="1" Height="42" MaxLength="6"
                 Style="{StaticResource InputTextBoxStyle}" VerticalContentAlignment="Center"
                 AutomationProperties.Name="Six-digit email verification code" KeyDown="OtpBox_KeyDown"/>
        <Button x:Name="VerifyOtpButton" Grid.Column="2" Content="Verify &amp; sync" Click="VerifyOtp_Click"
                Margin="12,0,0,0" Style="{StaticResource PrimaryButtonStyle}"
                AutomationProperties.Name="Verify and sync profiles"/>
      </Grid>
    </Border>

    <Grid Grid.Row="3">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock x:Name="StatusText" Grid.Row="0" Text="Not connected. Sign in to run a live read-only sync."
                 Foreground="{StaticResource SecondaryInkBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                 AutomationProperties.LiveSetting="Polite"/>
      <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="True">
        <Button x:Name="OpenTaxButton" DockPanel.Dock="Right"
                Content="Use selected profile for tax automation" Click="OpenTax_Click" IsEnabled="False"
                Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0"
                AutomationProperties.Name="Use selected profile for tax automation"/>
        <TextBlock Text="Select a member profile, then open tax automation. Profile selection does not download or change any data."
                   Foreground="{StaticResource SecondaryInkBrush}" VerticalAlignment="Center"
                   TextWrapping="Wrap" FontSize="12"/>
      </DockPanel>
      <DataGrid x:Name="ProfilesGrid" Grid.Row="2" SelectionMode="Single" SelectionUnit="FullRow"
                SelectionChanged="ProfilesGrid_SelectionChanged" AutoGenerateColumns="False"
                AutomationProperties.Name="Synchronized family and client profiles">
        <DataGrid.Columns>
          <DataGridTextColumn Header="FAMILY / ACCOUNT ID" Binding="{Binding FamilyAccountId}" Width="1.2*" MinWidth="130"/>
          <DataGridTextColumn Header="MEMBER PROFILE ID" Binding="{Binding ProfileId}" Width="1.2*" MinWidth="130"/>
          <DataGridTextColumn Header="PROFILE" Binding="{Binding DisplayName}" Width="*" MinWidth="105"/>
          <DataGridTextColumn Header="LEGAL NAME" Binding="{Binding LegalName}" Width="*" MinWidth="105"/>
          <DataGridTextColumn Header="RELATIONSHIP" Binding="{Binding Relationship}" Width="0.85*" MinWidth="95"/>
          <DataGridCheckBoxColumn Header="PRIMARY" Binding="{Binding IsPrimary}" Width="72"/>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </Grid>
</Window>
