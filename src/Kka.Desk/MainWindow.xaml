<Window x:Class="Kka.Desk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KKA Desk" Height="780" Width="1240" MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="#0B1422">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource NavyBrush}" Padding="22">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="0,4,0,30">
          <TextBlock Text="KKA" Foreground="{StaticResource GoldBrush}" FontSize="34" FontWeight="Bold"/>
          <TextBlock Text="DESK" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="2,0,0,0"/>
          <TextBlock Text="STAFF WORKSPACE" Foreground="#9AA9BC" FontSize="10" Margin="2,8,0,0"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="WORKSPACE" Foreground="#8292A8" FontSize="10" FontWeight="Bold" Margin="10,0,0,12"/>
          <Button Content="Overview" Click="Overview_Click" Margin="0,2" Padding="12" HorizontalContentAlignment="Left" Background="#24334A" Foreground="White" BorderThickness="0"/>
          <Button Content="Documents" Click="Documents_Click" Margin="0,2" Padding="12" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#D5DEEA" BorderThickness="0"/>
          <Button Content="Queries" Click="Queries_Click" Margin="0,2" Padding="12" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#D5DEEA" BorderThickness="0"/>
          <Button Content="Client directory" Click="Directory_Click" Margin="0,2" Padding="12" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#D5DEEA" BorderThickness="0"/>
          <Button Content="Work queue" Click="Queue_Click" Margin="0,2" Padding="12" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#D5DEEA" BorderThickness="0"/>
          <TextBlock Text="ADMINISTRATION" Foreground="#8292A8" FontSize="10" FontWeight="Bold" Margin="10,28,0,12"/>
          <Button Content="Admin" Click="Admin_Click" Margin="0,2" Padding="12" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#D5DEEA" BorderThickness="0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,24,0,0">
          <Border Height="1" Background="#344258" Margin="0,0,0,15"/>
          <TextBlock Text="Kamal Kuldeep &amp; Associates" Foreground="#D5DEEA" FontSize="11"/>
          <TextBlock Text="Private internal application" Foreground="#8292A8" FontSize="10" Margin="0,5,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="34">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,28">
        <StackPanel>
          <TextBlock x:Name="PageEyebrow" Text="KKA OPERATIONS" Foreground="{StaticResource GoldBrush}" FontSize="11" FontWeight="Bold"/>
          <TextBlock x:Name="PageTitle" Text="Good day." Foreground="White" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,0"/>
          <TextBlock Text="Your firm's work, organised in one place." Foreground="#9AA9BC" FontSize="13" Margin="0,7,0,0"/>
        </StackPanel>
        <Border DockPanel.Dock="Right" Background="#18263B" BorderBrush="#2A3B52" BorderThickness="1" CornerRadius="10" Padding="14,10" VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="#D6B56D" VerticalAlignment="Center" Margin="0,0,9,0"/>
            <TextBlock Text="Foundation preview" Foreground="#D5DEEA" FontSize="12"/>
          </StackPanel>
        </Border>
      </DockPanel>
      <Border Grid.Row="1" Background="#1B2A40" BorderBrush="#33445B" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,0,20">
        <StackPanel>
          <TextBlock Text="WELCOME TO KKA DESK" Foreground="{StaticResource GoldBrush}" FontSize="11" FontWeight="Bold"/>
          <TextBlock x:Name="PanelTitle" Text="One workspace. Clear priorities." Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,7"/>
          <TextBlock x:Name="PanelDescription" Text="The desktop foundation is in place. Secure sign-in and backend-connected modules are being integrated in phases." Foreground="#B7C4D5" FontSize="13" TextWrapping="Wrap" MaxWidth="740"/>
        </StackPanel>
      </Border>
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#121E30" BorderBrush="#26364B" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="IMPORTANT DUE DATES" Foreground="#9AA9BC" FontSize="11" FontWeight="Bold"/>
            <TextBlock Text="Awaiting connection" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,14,0,7"/>
            <TextBlock Text="Dates will be synchronised from the firm's authoritative website source. No dates are fabricated in this preview." Foreground="#9AA9BC" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="#121E30" BorderBrush="#26364B" BorderThickness="1" CornerRadius="12" Padding="20" Margin="10,0,0,0">
          <StackPanel>
            <TextBlock Text="SECURITY STATUS" Foreground="#9AA9BC" FontSize="11" FontWeight="Bold"/>
            <TextBlock Text="Integration pending" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,14,0,7"/>
            <TextBlock Text="Client data remains disabled until identity, MFA, role checks, and server-side client assignment rules are verified." Foreground="#9AA9BC" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
