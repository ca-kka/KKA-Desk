<Window x:Class="Kka.Desk.TaxAutomationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tax Automation | KKA Desk" Height="820" Width="1240"
        MinHeight="720" MinWidth="1060" WindowStartupLocation="CenterOwner"
        Background="#0B1422" Foreground="#E7EDF5">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,20">
      <StackPanel>
        <TextBlock Text="ADMINISTRATION / TAX OPERATIONS" Foreground="#D6B56D" FontSize="11" FontWeight="Bold"/>
        <TextBlock Text="Income Tax &amp; GST automation" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0"/>
        <TextBlock Text="Select a family account and one member profile, then preview its tax periods, documents and destination." Foreground="#9AA9BC" FontSize="12" Margin="0,7,0,0"/>
      </StackPanel>
      <Border DockPanel.Dock="Right" Background="#332B1D" BorderBrush="#7C6535" BorderThickness="1" CornerRadius="8" Padding="12,8" VerticalAlignment="Top">
        <TextBlock Text="PREVIEW MODE — NO PORTAL ACCESS" Foreground="#F0D99F" FontSize="11" FontWeight="Bold"/>
      </Border>
    </DockPanel>
    <Border Grid.Row="1" Background="#18263B" BorderBrush="#34465E" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18">
      <TextBlock Text="Safety boundary: this first build is a UI/workflow prototype. It does not store credentials, connect to government portals, download files, or write to the client portal. Live automation remains disabled until identity, credential vault, portal handling and destination are implemented and tested." TextWrapping="Wrap" Foreground="#C9D4E2" FontSize="12"/>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
        <StackPanel>
          <Border Background="#121E30" BorderBrush="#26364B" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="1. CLIENT &amp; TAX PROFILE" Foreground="#D6B56D" FontWeight="Bold" FontSize="11" Margin="0,0,0,14"/>
              <TextBlock Text="Family / primary-holder account ID" Foreground="#9AA9BC" FontSize="11"/>
              <TextBox x:Name="FamilyAccountIdBox" Margin="0,5,0,12" Padding="9" Background="#0B1422" Foreground="White" BorderBrush="#34465E" CaretBrush="White" ToolTip="Existing stable family/account ID. Do not create a new family record."/>
              <TextBlock Text="Selected member / client profile ID" Foreground="#9AA9BC" FontSize="11"/>
              <TextBox x:Name="ProfileIdBox" Margin="0,5,0,12" Padding="9" Background="#0B1422" Foreground="White" BorderBrush="#34465E" CaretBrush="White" ToolTip="Existing member profile ID; tax documents and settings are scoped to this profile."/>
              <TextBlock Text="Selected member / profile name" Foreground="#9AA9BC" FontSize="11"/>
              <TextBox x:Name="ProfileNameBox" Margin="0,5,0,12" Padding="9" Background="#0B1422" Foreground="White" BorderBrush="#34465E" CaretBrush="White"/>
              <TextBlock Text="Relationship / profile type" Foreground="#9AA9BC" FontSize="11"/>
              <ComboBox x:Name="ProfileTypeBox" Margin="0,5,0,12" Padding="7" SelectedIndex="0">
                <ComboBoxItem Content="Primary holder"/>
                <ComboBoxItem Content="Family member"/>
                <ComboBoxItem Content="Individual client"/>
                <ComboBoxItem Content="Business / entity"/>
              </ComboBox>
              <TextBlock Text="PROFILE ISOLATION: Tax IDs, credentials, filing frequency and documents apply to the selected profile only. Family members do not get separate logins." Foreground="#D6B56D" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
              <CheckBox x:Name="IncomeTaxEnabled" Content="Income Tax enabled" IsChecked="True" Margin="0,0,0,9" Foreground="#E7EDF5"/>
              <CheckBox x:Name="AuditCase" Content="Tax audit case (confirm per year)" Margin="0,0,0,12" Foreground="#E7EDF5"/>
              <TextBlock Text="Financial year" Foreground="#9AA9BC" FontSize="11"/>
              <ComboBox x:Name="FinancialYearBox" Margin="0,5,0,12" Padding="7" SelectedIndex="0">
                <ComboBoxItem Content="FY 2025–26 / AY 2026–27"/>
                <ComboBoxItem Content="Tax Year 2026–27"/>
                <ComboBoxItem Content="FY 2024–25 / AY 2025–26"/>
              </ComboBox>
              <TextBlock Text="GSTIN" Foreground="#9AA9BC" FontSize="11"/>
              <TextBox x:Name="GstinBox" Margin="0,5,0,12" Padding="9" Background="#0B1422" Foreground="White" BorderBrush="#34465E" CaretBrush="White"/>
              <CheckBox x:Name="GstEnabled" Content="GST enabled" IsChecked="True" Margin="0,0,0,9" Foreground="#E7EDF5"/>
              <TextBlock Text="GST filing frequency" Foreground="#9AA9BC" FontSize="11"/>
              <ComboBox x:Name="FrequencyBox" Margin="0,5,0,8" Padding="7" SelectedIndex="0">
                <ComboBoxItem Content="Monthly"/>
                <ComboBoxItem Content="Quarterly (QRMP)"/>
              </ComboBox>
              <TextBlock Text="Frequency effective from" Foreground="#9AA9BC" FontSize="11"/>
              <TextBox x:Name="FrequencyEffectiveBox" Text="2025-04" Margin="0,5,0,0" Padding="9" Background="#0B1422" Foreground="White" BorderBrush="#34465E" CaretBrush="White" ToolTip="YYYY-MM. Historical periods use the frequency effective at that time."/>
            </StackPanel>
          </Border>
          <Border Background="#121E30" BorderBrush="#26364B" BorderThickness="1" CornerRadius="12" Padding="18">
            <StackPanel>
              <TextBlock Text="2. DOCUMENTS TO REQUEST" Foreground="#D6B56D" FontWeight="Bold" FontSize="11" Margin="0,0,0,14"/>
              <CheckBox x:Name="ItrDocs" Content="ITR return / acknowledgement" IsChecked="True" Margin="0,0,0,10" Foreground="#E7EDF5"/>
              <CheckBox x:Name="AuditDocs" Content="Tax audit report / available attachments" Margin="0,0,0,10" Foreground="#E7EDF5"/>
              <CheckBox x:Name="Gstr1Docs" Content="GSTR-1" IsChecked="True" Margin="0,0,0,10" Foreground="#E7EDF5"/>
              <CheckBox x:Name="Gstr3bDocs" Content="GSTR-3B" IsChecked="True" Margin="0,0,0,10" Foreground="#E7EDF5"/>
              <TextBlock Text="GST period scope" Foreground="#9AA9BC" FontSize="11" Margin="0,6,0,0"/>
              <ComboBox x:Name="PeriodScopeBox" Margin="0,5,0,0" Padding="7" SelectedIndex="0">
                <ComboBoxItem Content="Current FY — all applicable periods"/>
                <ComboBoxItem Content="Latest completed period only"/>
                <ComboBoxItem Content="Select period manually (later phase)"/>
              </ComboBox>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#121E30" BorderBrush="#26364B" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="3. JOB PREVIEW" Foreground="#D6B56D" FontSize="11" FontWeight="Bold"/>
            <TextBlock Text="Preview first. No portal actions happen from this screen yet." Foreground="#9AA9BC" FontSize="12" Margin="0,6,0,12"/>
            <WrapPanel>
              <Button Content="Build job preview" Click="Preview_Click" Padding="14,9" Margin="0,0,8,0" Background="#D6B56D" Foreground="#0B1422" BorderThickness="0" FontWeight="SemiBold"/>
              <Button Content="Run downloads" Click="Run_Click" Padding="14,9" Margin="0,0,8,0" Background="#26364B" Foreground="#8292A8" BorderThickness="0" IsEnabled="False" ToolTip="Enabled after secure portal automation is implemented."/>
              <Button Content="Punch documents" Click="Punch_Click" Padding="14,9" Background="#26364B" Foreground="#8292A8" BorderThickness="0" IsEnabled="False" ToolTip="Enabled after download validation and destination integration."/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="#121E30" BorderBrush="#26364B" BorderThickness="1" CornerRadius="12" Padding="16">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
              <TextBlock Text="Planned tasks" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock x:Name="TaskCountText" Text="0 tasks" DockPanel.Dock="Right" Foreground="#9AA9BC" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
            <DataGrid x:Name="TasksGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" Background="#0B1422" Foreground="#E7EDF5" BorderBrush="#26364B" GridLinesVisibility="Horizontal" RowBackground="#121E30" AlternatingRowBackground="#18263B">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Tax" Binding="{Binding TaxType}" Width="90"/>
                <DataGridTextColumn Header="Document" Binding="{Binding Document}" Width="*"/>
                <DataGridTextColumn Header="Period" Binding="{Binding Period}" Width="140"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="125"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
        <Border Grid.Row="2" Background="#18263B" BorderBrush="#34465E" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="4. PUNCH DESTINATION PREVIEW" Foreground="#D6B56D" FontWeight="Bold" FontSize="11"/>
            <TextBlock x:Name="PunchPreviewText" Text="Build a job preview to inspect the intended client folders. Destination is not connected yet." TextWrapping="Wrap" Foreground="#C9D4E2" FontSize="12" Margin="0,7,0,0"/>
            <TextBlock x:Name="StatusText" Text="Ready — preview only." Foreground="#9AA9BC" FontSize="11" Margin="0,9,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>